{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elatura.local/schemas/benchmark-run-manifest-v2.schema.json",
  "title": "Elatura content-free benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "recordedAt",
    "mode",
    "navigation",
    "sequence",
    "browser",
    "timings",
    "memory",
    "outcome",
    "observerReportRunId",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "type": "string", "format": "uuid" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["edge-stock", "firefox-stock", "firefox-observe"] },
    "navigation": { "enum": ["cold-open", "hard-reload", "client-navigation"] },
    "sequence": { "type": "integer", "minimum": 1 },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile"],
      "properties": {
        "name": { "enum": ["Edge", "Firefox"] },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"
        },
        "profile": { "const": "clean-test" }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "domContentLoadedMs", "composerReadyMs"],
      "properties": {
        "source": { "enum": ["manual", "observer-report"] },
        "domContentLoadedMs": { "type": ["number", "null"], "minimum": 0 },
        "composerReadyMs": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "memory": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "peaks"],
          "properties": {
            "method": { "enum": ["activity-monitor", "task-manager", "ps"] },
            "peaks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["processClass", "peakBytes"],
                "properties": {
                  "processClass": {
                    "enum": [
                      "browser-total",
                      "browser-main",
                      "content-total",
                      "content-peak",
                      "gpu",
                      "extension"
                    ]
                  },
                  "peakBytes": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failureCode"],
      "properties": {
        "status": { "enum": ["usable", "failed", "cancelled"] },
        "failureCode": {
          "enum": [
            null,
            "browser-crash",
            "navigation-error",
            "composer-unavailable",
            "timeout",
            "operator-cancelled"
          ]
        }
      }
    },
    "observerReportRunId": { "type": ["string", "null"], "format": "uuid" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentCaptured", "urlsCaptured", "notesCaptured", "processCommandLinesCaptured"],
      "properties": {
        "contentCaptured": { "const": false },
        "urlsCaptured": { "const": false },
        "notesCaptured": { "const": false },
        "processCommandLinesCaptured": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "edge-stock" } } },
      "then": {
        "properties": {
          "browser": { "properties": { "name": { "const": "Edge" } } },
          "timings": { "properties": { "source": { "const": "manual" } } },
          "observerReportRunId": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "firefox-stock" } } },
      "then": {
        "properties": {
          "browser": { "properties": { "name": { "const": "Firefox" } } },
          "timings": { "properties": { "source": { "const": "manual" } } },
          "observerReportRunId": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "firefox-observe" } } },
      "then": {
        "properties": {
          "browser": { "properties": { "name": { "const": "Firefox" } } },
          "timings": { "properties": { "source": { "const": "observer-report" } } },
          "observerReportRunId": { "type": "string", "format": "uuid" }
        }
      }
    },
    {
      "if": { "properties": { "outcome": { "properties": { "status": { "const": "usable" } } } } },
      "then": { "properties": { "outcome": { "properties": { "failureCode": { "type": "null" } } } } },
      "else": { "properties": { "outcome": { "properties": { "failureCode": { "type": "string" } } } } }
    }
  ]
}
