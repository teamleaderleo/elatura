{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elatura.local/schemas/live-application-lane-projection-v1.schema.json",
  "title": "Elatura content-free application lane projection ledger",
  "description": "Separates a logical lane from ephemeral browser projections and records content-free signal confidence/freshness for one physical benchmark subrun.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sessionId",
    "runId",
    "logicalLanes",
    "signals",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "live-application-lane-projection-ledger" },
    "sessionId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "logicalLanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/lane" }
    },
    "signals": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/signal" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationContentCaptured",
        "rawApplicationLocatorCaptured",
        "profileIdCaptured",
        "tabIdCaptured",
        "targetIdCaptured",
        "processIdCaptured",
        "credentialsCaptured",
        "freeFormNotesCaptured"
      ],
      "properties": {
        "applicationContentCaptured": { "const": false },
        "rawApplicationLocatorCaptured": { "const": false },
        "profileIdCaptured": { "const": false },
        "tabIdCaptured": { "const": false },
        "targetIdCaptured": { "const": false },
        "processIdCaptured": { "const": false },
        "credentialsCaptured": { "const": false },
        "freeFormNotesCaptured": { "const": false }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laneOrdinal",
        "logicalLaneToken",
        "application",
        "locatorClass",
        "projectionGeneration",
        "projectionState",
        "freshness",
        "recoveryState",
        "interventionLevel"
      ],
      "properties": {
        "laneOrdinal": { "type": "integer", "minimum": 1, "maximum": 8 },
        "logicalLaneToken": { "$ref": "#/$defs/token" },
        "application": { "enum": ["chatgpt", "google-docs"] },
        "locatorClass": {
          "enum": [
            "opaque-local-conversation",
            "opaque-local-document",
            "opaque-local-application-target"
          ]
        },
        "projectionGeneration": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "projectionState": {
          "enum": [
            "active",
            "background",
            "parked",
            "discarded",
            "unavailable",
            "recovering",
            "recovered",
            "drifted"
          ]
        },
        "freshness": { "enum": ["fresh", "stale", "drifted", "unknown"] },
        "recoveryState": {
          "enum": ["none", "needed", "in-progress", "recovered", "failed", "unknown"]
        },
        "interventionLevel": {
          "enum": [
            "stock",
            "observe-only",
            "lifecycle-parking",
            "render-suppression",
            "bounded-dom",
            "bounded-view",
            "response-transform"
          ]
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "elapsedMs",
        "laneOrdinal",
        "class",
        "confidence",
        "freshness",
        "sourceClass",
        "causedInspection"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "elapsedMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "laneOrdinal": { "type": "integer", "minimum": 1, "maximum": 8 },
        "class": {
          "enum": [
            "changed",
            "generating",
            "idle",
            "possible-completion",
            "error",
            "drifted",
            "parked",
            "discarded-or-unavailable",
            "recovery-needed",
            "visual-attention-requested"
          ]
        },
        "confidence": { "enum": ["exact-application-state", "direct-local-event", "heuristic", "unknown"] },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "sourceClass": {
          "enum": ["application-event", "dom", "accessibility", "browser-lifecycle", "network-lifecycle", "notification-hint", "unknown"]
        },
        "causedInspection": { "type": "boolean" }
      }
    }
  }
}
