{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elatura.local/schemas/live-application-lane-plan-v1.schema.json",
  "title": "Elatura live application lane benchmark session plan",
  "description": "Content-free pre-registration of the required live-lane resource matrix. Generate before collection and keep unchanged for the session.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "sessionId",
    "generatedAt",
    "browsers",
    "elatura",
    "protocol",
    "stages",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "live-application-lane-plan" },
    "sessionId": { "type": "string", "format": "uuid" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "browsers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ES", "CS", "CRS", "FS"],
      "properties": {
        "ES": { "$ref": "#/$defs/browserIdentity" },
        "CS": { "$ref": "#/$defs/browserIdentity" },
        "CRS": { "$ref": "#/$defs/browserIdentity" },
        "FS": { "$ref": "#/$defs/browserIdentity" }
      }
    },
    "elatura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "firefoxInterventionToken", "chromiumInterventionToken"],
      "properties": {
        "revision": { "$ref": "#/$defs/versionToken" },
        "firefoxInterventionToken": { "$ref": "#/$defs/token" },
        "chromiumInterventionToken": { "$ref": "#/$defs/token" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samplePeriodMs",
        "betweenPhysicalSubrunsMs",
        "settleMs",
        "steadyForegroundMs",
        "singleLaneBackgroundProbeCount",
        "singleLaneBackgroundDwellMs",
        "switchLaneCount",
        "switchWarmupRotations",
        "switchRecordedRotations",
        "switchDwellMs",
        "longBackgroundMs",
        "switchTimeoutMs",
        "restartWaitMs"
      ],
      "properties": {
        "samplePeriodMs": { "const": 2000 },
        "betweenPhysicalSubrunsMs": { "const": 60000 },
        "settleMs": { "const": 120000 },
        "steadyForegroundMs": { "const": 600000 },
        "singleLaneBackgroundProbeCount": { "const": 10 },
        "singleLaneBackgroundDwellMs": { "const": 30000 },
        "switchLaneCount": { "const": 8 },
        "switchWarmupRotations": { "const": 2 },
        "switchRecordedRotations": { "const": 12 },
        "switchDwellMs": { "const": 15000 },
        "longBackgroundMs": { "const": 300000 },
        "switchTimeoutMs": { "const": 15000 },
        "restartWaitMs": { "const": 60000 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/chatgptSingleStage" },
        { "$ref": "#/$defs/chatgptSwitchStage" },
        { "$ref": "#/$defs/gdocsSingleStage" },
        { "$ref": "#/$defs/gdocsSwitchStage" }
      ],
      "items": false
    },
    "privacy": { "$ref": "#/$defs/privacy" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "versionToken": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,95}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "browserIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "engineFamily", "version", "buildToken"],
      "properties": {
        "product": { "enum": ["Edge", "Chrome", "Chromium", "Firefox"] },
        "engineFamily": { "enum": ["blink-v8", "gecko-spidermonkey"] },
        "version": { "$ref": "#/$defs/versionToken" },
        "buildToken": { "$ref": "#/$defs/versionToken" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationContentCaptured",
        "titlesCaptured",
        "urlsCaptured",
        "credentialsCaptured",
        "screenshotsCaptured",
        "rawDomCaptured",
        "freeFormNotesCaptured"
      ],
      "properties": {
        "applicationContentCaptured": { "const": false },
        "titlesCaptured": { "const": false },
        "urlsCaptured": { "const": false },
        "credentialsCaptured": { "const": false },
        "screenshotsCaptured": { "const": false },
        "rawDomCaptured": { "const": false },
        "freeFormNotesCaptured": { "const": false }
      }
    },
    "physicalSubrun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "mode"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 2 },
        "mode": { "enum": ["none", "passive", "managed"] }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditionOrdinal", "conditionCode", "physicalSubruns"],
      "properties": {
        "conditionOrdinal": { "type": "integer", "minimum": 1, "maximum": 6 },
        "conditionCode": { "enum": ["ES", "CS", "CRS", "FS", "FE", "CRE"] },
        "physicalSubruns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/physicalSubrun" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "orderRow", "conditionOrder", "slots"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 5 },
        "orderRow": { "type": "integer", "minimum": 1, "maximum": 6 },
        "conditionOrder": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["ES", "CS", "CRS", "FS", "FE", "CRE"] }
        },
        "slots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "stageBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "application", "workloadToken", "pattern", "laneCount", "blockCount", "blocks"],
      "properties": {
        "stage": { "enum": ["chatgpt-single", "chatgpt-switch-8", "gdocs-single", "gdocs-switch-8"] },
        "application": { "enum": ["chatgpt", "google-docs"] },
        "workloadToken": { "$ref": "#/$defs/token" },
        "pattern": { "enum": ["single-lane", "switch-8"] },
        "laneCount": { "enum": [1, 8] },
        "blockCount": { "enum": [3, 5] },
        "blocks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "chatgptSingleStage": {
      "allOf": [
        { "$ref": "#/$defs/stageBase" },
        {
          "properties": {
            "stage": { "const": "chatgpt-single" },
            "application": { "const": "chatgpt" },
            "workloadToken": { "const": "chatgpt-pathological-a" },
            "pattern": { "const": "single-lane" },
            "laneCount": { "const": 1 },
            "blockCount": { "const": 5 },
            "blocks": { "minItems": 5, "maxItems": 5 }
          }
        }
      ]
    },
    "chatgptSwitchStage": {
      "allOf": [
        { "$ref": "#/$defs/stageBase" },
        {
          "properties": {
            "stage": { "const": "chatgpt-switch-8" },
            "application": { "const": "chatgpt" },
            "workloadToken": { "const": "chatgpt-switch-8" },
            "pattern": { "const": "switch-8" },
            "laneCount": { "const": 8 },
            "blockCount": { "const": 3 },
            "blocks": { "minItems": 3, "maxItems": 3 }
          }
        }
      ]
    },
    "gdocsSingleStage": {
      "allOf": [
        { "$ref": "#/$defs/stageBase" },
        {
          "properties": {
            "stage": { "const": "gdocs-single" },
            "application": { "const": "google-docs" },
            "workloadToken": { "const": "gdocs-text-100k-v1" },
            "pattern": { "const": "single-lane" },
            "laneCount": { "const": 1 },
            "blockCount": { "const": 3 },
            "blocks": { "minItems": 3, "maxItems": 3 }
          }
        }
      ]
    },
    "gdocsSwitchStage": {
      "allOf": [
        { "$ref": "#/$defs/stageBase" },
        {
          "properties": {
            "stage": { "const": "gdocs-switch-8" },
            "application": { "const": "google-docs" },
            "workloadToken": { "const": "gdocs-switch-8" },
            "pattern": { "const": "switch-8" },
            "laneCount": { "const": 8 },
            "blockCount": { "const": 3 },
            "blocks": { "minItems": 3, "maxItems": 3 }
          }
        }
      ]
    }
  }
}
