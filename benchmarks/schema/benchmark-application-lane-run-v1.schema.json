{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elatura.dev/schema/benchmark-application-lane-run-v1.schema.json",
  "title": "Elatura application lane benchmark run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "recordedAt", "lane", "environment", "projection", "attention", "timingsMs", "resources", "fidelity", "privacy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "recordedAt": { "type": "string", "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$" },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["laneKey", "applicationClass", "targetClass", "targetTokenPresent"],
      "properties": {
        "laneKey": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,127}$" },
        "applicationClass": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$" },
        "targetClass": { "enum": ["conversation", "document", "timeline", "console", "notebook", "other"] },
        "targetTokenPresent": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browserClass", "browserVersionToken", "cohort", "interventionLevel"],
      "properties": {
        "browserClass": { "enum": ["gecko", "chromium", "webkit"] },
        "browserVersionToken": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$" },
        "cohort": { "enum": ["stock", "elatura"] },
        "interventionLevel": { "enum": ["stock-observe", "lifecycle-managed", "render-suppression", "bounded-dom", "bounded-representation", "response-transform"] }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings", "replacements", "losses", "recoveries", "unrecoveredLosses", "maxConcurrentProjections"],
      "properties": {
        "bindings": { "$ref": "#/$defs/nonNegativeInteger" },
        "replacements": { "$ref": "#/$defs/nonNegativeInteger" },
        "losses": { "$ref": "#/$defs/nonNegativeInteger" },
        "recoveries": { "$ref": "#/$defs/nonNegativeInteger" },
        "unrecoveredLosses": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxConcurrentProjections": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "highestRung", "operations", "falsePositiveSignals", "missedChanges"],
      "properties": {
        "episodes": { "$ref": "#/$defs/nonNegativeInteger" },
        "highestRung": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signalOnly", "boundedSemantic", "screenshot", "fullActivation"],
          "properties": {
            "signalOnly": { "$ref": "#/$defs/nonNegativeInteger" },
            "boundedSemantic": { "$ref": "#/$defs/nonNegativeInteger" },
            "screenshot": { "$ref": "#/$defs/nonNegativeInteger" },
            "fullActivation": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signals", "boundedSemanticReads", "screenshots", "fullActivations"],
          "properties": {
            "signals": { "$ref": "#/$defs/nonNegativeInteger" },
            "boundedSemanticReads": { "$ref": "#/$defs/nonNegativeInteger" },
            "screenshots": { "$ref": "#/$defs/nonNegativeInteger" },
            "fullActivations": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "falsePositiveSignals": { "$ref": "#/$defs/nonNegativeInteger" },
        "missedChanges": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "timingsMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialUsableMs", "switchBackMs", "recoveryMs", "boundedReadMs", "screenshotMs", "activationMs"],
      "properties": {
        "initialUsableMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "switchBackMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "recoveryMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "boundedReadMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "screenshotMs": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "activationMs": { "$ref": "#/$defs/nullableNonNegativeNumber" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/resourceSample" } }
      }
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritativeApplicationPreserved", "normalInteractionAvailable", "currentWorkStatePreserved", "recoveryFailures", "driftFailOpenCount"],
      "properties": {
        "authoritativeApplicationPreserved": { "const": true },
        "normalInteractionAvailable": { "type": "boolean" },
        "currentWorkStatePreserved": { "type": "boolean" },
        "recoveryFailures": { "$ref": "#/$defs/nonNegativeInteger" },
        "driftFailOpenCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentCaptured", "urlsCaptured", "credentialsCaptured", "nativeBrowserIdsCaptured", "screenshotBytesCaptured"],
      "properties": {
        "contentCaptured": { "const": false },
        "urlsCaptured": { "const": false },
        "credentialsCaptured": { "const": false },
        "nativeBrowserIdsCaptured": { "const": false },
        "screenshotBytesCaptured": { "const": false }
      }
    }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nullableNonNegativeNumber": { "type": ["number", "null"], "minimum": 0 },
    "resourceSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "browserProcessBytes", "rendererProcessBytes", "cpuMillis", "domElements", "textNodes", "mountedApplicationUnits", "elaturaRetainedBytes"],
      "properties": {
        "phase": { "enum": ["idle", "streaming-or-editing", "switch", "inspection", "recovery"] },
        "browserProcessBytes": { "type": ["integer", "null"], "minimum": 0 },
        "rendererProcessBytes": { "type": ["integer", "null"], "minimum": 0 },
        "cpuMillis": { "$ref": "#/$defs/nullableNonNegativeNumber" },
        "domElements": { "type": ["integer", "null"], "minimum": 0 },
        "textNodes": { "type": ["integer", "null"], "minimum": 0 },
        "mountedApplicationUnits": { "type": ["integer", "null"], "minimum": 0 },
        "elaturaRetainedBytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    }
  }
}
