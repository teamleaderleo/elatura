{
  "manifest_version": 3,
  "name": "Elatura Observer",
  "version": "0.0.9",
  "description": "Observe content-free performance characteristics and prototype fail-open local slimming for oversized ChatGPT pages.",
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "scripts": [
      "background.js",
      "chatgpt-lane-activity-background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "chatgpt-lane-activity-producer.js",
        "slim-content-controller.js",
        "slim-discovery.js",
        "slim-live-discovery.js",
        "slim-window.js"
      ],
      "matches": ["https://chatgpt.com/*"]
    }
  ],
  "action": {
    "default_title": "Elatura Observer",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "observer@elatura.com",
      "strict_min_version": "112.0"
    }
  }
}
