{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@elatura/core": ["../core/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "references": [{ "path": "../core" }],
  "include": ["src/**/*.ts"]
}
